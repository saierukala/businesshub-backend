NODE_ENV=development
PORT=4000
# Local Postgres, or a Neon/Supabase connection string (use the DIRECT, non-pooled URL for migrations)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/businesshub?schema=public"
# Separate database for `npm test` (tests wipe it). The name must contain "test".
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/businesshub_test?schema=public"
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL=info
# Optional. Leave empty in dev: emails are logged to the terminal instead of sent.
# e.g. smtp://user:pass@smtp.ethereal.email:587
SMTP_URL=
EMAIL_FROM="HomeFix <no-reply@homefix.test>"
